rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Products collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Fallback for any other collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
