# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Stripe payment gateway secret API key (keep server-side only)
STRIPE_SECRET_KEY=

# VITE_STRIPE_PUBLISHABLE_KEY: Stripe public client key for Stripe Elements / loadStripe
VITE_STRIPE_PUBLISHABLE_KEY=

# LALAMOVE_API_KEY: Lalamove Delivery Partner API key (sandbox starts with pk_test_...)
LALAMOVE_API_KEY=
# LALAMOVE_SECRET_KEY: Lalamove Delivery Partner secret key (sandbox starts with sk_test_...)
LALAMOVE_SECRET_KEY=
# LALAMOVE_MARKET: Market code (e.g. PH for Philippines)
LALAMOVE_MARKET=PH
# LALAMOVE_ENV: sandbox or production
LALAMOVE_ENV=sandbox
